# Supabase (Produção / Staging)
NEXT_PUBLIC_SUPABASE_URL=https://sua-url-do-supabase.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui

# Segredos de Servidor (NUNCA expor no cliente)
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui

# Apify (Busca Google Maps)
APIFY_TOKEN=seu-token-apify-aqui

# Segurança Dedup (Segredo do HMAC-SHA256)
DEDUP_PEPPER=chave-secreta-para-hashes-irreversiveis

# Ambiente e Fuso Horário
NODE_ENV=production
TZ=America/Sao_Paulo
